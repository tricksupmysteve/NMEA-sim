# ---------------------------------------------------------------------------
# Matey NMEA Simulator — example configuration
#
# Copy to `.env` and edit. Every value here is a default; the file is optional,
# and real environment variables always win over it.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- NMEA 0183 over TCP -----------------------------------------------------
# This is the stream Matey connects to.
#
# Bind to 0.0.0.0, not 127.0.0.1: a phone on the same Wi-Fi network cannot
# reach a loopback-only socket.
NMEA_HOST=0.0.0.0
NMEA_PORT=39150

# --- HTTP control API -------------------------------------------------------
# Separate from the NMEA stream. Railway injects PORT for the HTTP service.
PORT=3000
HTTP_HOST=0.0.0.0
HTTP_ENABLED=true
# Set to require `Authorization: Bearer <token>` on everything except /health.
# API_TOKEN=
CORS_ORIGIN=*

# --- Simulation -------------------------------------------------------------
# sailing | cruising | anchored | storm | sensor-failure
SIM_SCENARIO=sailing
# The same seed and scenario reproduce substantially the same data sequence.
SIM_SEED=12345
# Physics integration rate. Instruments and sentences have their own rates.
SIM_PHYSICS_HZ=20
# Multiplier on the passage of simulated time. 1 = real time.
SIM_TIME_SCALE=1
# Pin the simulated UTC start instant (ISO-8601). Defaults to the process start.
# SIM_START_TIME=2026-03-14T09:26:53Z

# --- Output profile ---------------------------------------------------------
# garmin-wifi | garmin-wifi-full | minimal | full
NMEA_PROFILE=garmin-wifi

# --- Instruments ------------------------------------------------------------
# Disable one to see how a consumer behaves when a source simply is not there.
ENABLE_GPS=true
ENABLE_HEADING=true
ENABLE_WIND=true
ENABLE_DEPTH=true
ENABLE_WATER_SPEED=true
ENABLE_TEMPERATURE=true
ENABLE_PRESSURE=true
ENABLE_ATTITUDE=true
# AIS is optional; nothing else depends on it.
ENABLE_AIS=false

# --- Sensor sampling rates (milliseconds) -----------------------------------
# Deliberately independent of the sentence rates below, so a consumer sees
# genuinely different data ages per source.
SENSOR_INTERVAL_GPS_MS=250
SENSOR_INTERVAL_HEADING_MS=100
SENSOR_INTERVAL_WIND_MS=200
SENSOR_INTERVAL_DEPTH_MS=500
SENSOR_INTERVAL_WATER_SPEED_MS=250
SENSOR_INTERVAL_TEMPERATURE_MS=2000
SENSOR_INTERVAL_PRESSURE_MS=5000
SENSOR_INTERVAL_ATTITUDE_MS=100
SENSOR_INTERVAL_AIS_MS=5000

# --- Sentence transmission rates (hertz) ------------------------------------
# These override the profile. Set one to 0 to stop transmitting it; set a
# sentence the profile does not include to start transmitting it.
# NMEA_RATE_HDT=5
# NMEA_RATE_MWV=5
# NMEA_RATE_VHW=2
# NMEA_RATE_RMC=1
# NMEA_RATE_GGA=1
# NMEA_RATE_VTG=1
# NMEA_RATE_MWD=1
# NMEA_RATE_DPT=1
# NMEA_RATE_MTW=0.2

# --- Environment and instrument calibration ---------------------------------
# Positive is east. The default suits the New England coast.
MAGNETIC_VARIATION_DEG=-14.5
COMPASS_DEVIATION_DEG=0.5
GNSS_ACCURACY_M=2.5
NMEA_COORDINATE_DECIMALS=4
NMEA_TIME_DECIMALS=2

# --- Own ship identity (used by the optional AIS output) --------------------
OWN_SHIP_MMSI=366123456
OWN_SHIP_NAME=MATEY SIM
OWN_SHIP_CALLSIGN=MTY1
OWN_SHIP_TYPE=36

# --- TCP client handling ----------------------------------------------------
NMEA_MAX_CLIENTS=64
# A client whose socket backs up past this many bytes starts losing sentences
# rather than growing an unbounded queue in the simulator.
NMEA_CLIENT_HIGH_WATER_BYTES=262144
# And is disconnected outright past this.
NMEA_CLIENT_HARD_LIMIT_BYTES=2097152

# --- Optional UDP output ----------------------------------------------------
UDP_ENABLED=false
UDP_HOST=255.255.255.255
UDP_PORT=10110
UDP_BROADCAST=true

# --- Logging ----------------------------------------------------------------
# Print every sentence as it is transmitted. Noisy; same as --verbose.
LOG_NMEA=false
# silent | error | warn | info | debug
LOG_LEVEL=info
# Milliseconds between console status refreshes. 0 disables the dashboard.
STATUS_INTERVAL_MS=5000
QUIET=false
